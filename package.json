{
  "name": "qqbot-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker QQ Bot pushing daily puzzle/knowledge/story content to QQ groups.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:scf": "esbuild scf/index.ts --bundle --platform=node --format=cjs --outfile=dist-scf/index.js --target=node18",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260820.0",
    "@types/js-yaml": "^4.0.9",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.125.0"
  }
}
